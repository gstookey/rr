# backend.env -- back-end / platform-tool pins for the air-gapped RHEL 9 dev bundle.
# Created 2026-10-01 (vetted against the live download sites that day).
# Sourced by tools/build-backend-bundle.sh. Library pins live in backend/gradle/libs.versions.toml.

TEMURIN_FEATURE=25                 # architect: Java 25 (LTS)
TEMURIN_RELEASE="jdk-25.0.4.1+1"   # newest Temurin 25 GA on 2026-10-01 (Adoptium API)
GRADLE_VERSION=9.7.1               # architect; also what start.spring.io generates for Boot 4.1.1. 9.8.0 shipped 2026-09-24.
ECLIPSE_RELEASE=2026-09            # architect "Eclipse IDE 4.41" == simultaneous release 2026-09 R (platform 4.41.0)
ECLIPSE_PACKAGE=jee                # "Enterprise Java and Web Developers" (593 MB); "java" is the 362 MB plain-Java package
HELM_VERSION=v4.0.5                # architect (exists; v4.3.0 is newer)

# kubectl: the architect's "kubectl 5.0.4" does not exist -- 5.0.4 is the Kustomize version that
# kubectl 1.27-1.30 prints in `kubectl version`. kubectl must be within one minor of the target
# cluster. PLACEHOLDER: set this to the island cluster's minor before building. NEEDS DEVOPS.
KUBECTL_VERSION=v1.37.1            # current upstream stable on 2026-10-01 -- a placeholder, not a decision
