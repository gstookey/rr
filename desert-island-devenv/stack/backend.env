# backend.env -- back-end / platform-tool pins for the air-gapped RHEL 9 dev bundle.
# Created 2026-10-01 (vetted against the live download sites that day).
# Sourced by tools/build-backend-bundle.sh. Library pins live in backend/gradle/libs.versions.toml.

TEMURIN_FEATURE=25                 # architect: Java 25 (LTS)
TEMURIN_RELEASE="jdk-25.0.4.1+1"   # newest Temurin 25 GA on 2026-10-01 (Adoptium API)
GRADLE_VERSION=9.7.1               # architect; also what start.spring.io generates for Boot 4.1.1. 9.8.0 shipped 2026-09-24.
ECLIPSE_RELEASE=2026-09            # architect "Eclipse IDE 4.41" == simultaneous release 2026-09 R (platform 4.41.0)
ECLIPSE_PACKAGE=jee                # "Enterprise Java and Web Developers" (593 MB); "java" is the 362 MB plain-Java package
# --- Kubernetes client tools (revised 2026-10-01 from Graham's `kubectl version` on the legacy
# island: client v1.35.0 / server v1.30.4 -- outside the supported +/-1 skew). The only cluster we
# know runs 1.30 (end-of-life upstream since 2025-06), so every tool below is chosen to be
# SUPPORTED against 1.30 and to need one edit here when the cluster moves. NEEDS DEVOPS: the
# Desert Island cluster's version (O-1) -- if it is not 1.30, revisit all four lines.
KUBECTL_VERSION=v1.31.14           # newest 1.31.x; kubectl 1.31 supports 1.30, 1.31 and 1.32 servers
HELM_VERSION=v3.18.6               # installed as `helm`. Helm's skew table: 3.18.x is the newest line
                                   # that supports 1.30 (1.30-1.33). 1 moderate advisory, fixed only
                                   # in 3.20.2+/4.1.4+ (which support 1.32+). The architect's v4.0.5
                                   # supports 1.31-1.34 and has 2 HIGH advisories (fixed in 4.1.4).
HELM4_VERSION=v4.3.0               # installed as `helm4`: the architect's Helm 4, advisory-free newest
                                   # (supports 1.34-1.37) -- becomes `helm` when the cluster gets there
KIND_VERSION=v0.29.0               # kind release whose node images include 1.30 (v0.33.0 builds 1.33+)
KIND_NODE_TAG=v1.30.13             # kindest/node tag for local clusters: matches the 1.30 server minor
                                   # (kind v0.29.0 release; index digest sha256:397209b3d947d154f6641f2d0ce8d473732bd91c87d9575ade99049aa33cd648)

# --- Docker CE for RHEL 9 (Graham 2026-10-01: Docker, not Podman). Not on RHEL media, so the
# RPMs travel in the bundle. File names and sha256 come from the repository's own metadata
# (repodata primary.xml, 2026-10-01); the RPMs are also GPG-signed by Docker and checked on the
# island with the key below. Their dependencies (container-selinux, libseccomp, iptables-nft,
# nftables, tar, xz) ARE on the RHEL 9 media -- verified present in the UBI 9 repos.
DOCKER_CE_BASEURL=https://download.docker.com/linux/rhel/9/x86_64/stable
DOCKER_CE_RPMS="
containerd.io-2.3.6-1.el9.x86_64.rpm         57445951673c94e937aa382ec5acf981f9bf1731545eb22ba620b80181b8877c
docker-ce-cli-29.8.2-1.el9.x86_64.rpm        aaf494165650b6c8c4302e1ddbb8788048421403234e7c2648a5c2aacc53d382
docker-ce-29.8.2-1.el9.x86_64.rpm            34f9baa4ab43363d6f173fc1466c5e5c7a89c01f56c5459e21f1edbd7cc23e10
docker-buildx-plugin-0.37.1-1.el9.x86_64.rpm 5fa94ac977c34e3787d3c44d126e0723d6cc955016d61ad58ee51f10c1376f76
docker-compose-plugin-5.5.1-1.el9.x86_64.rpm 3902211558df7a3843b4f8872b0be7facaf52e74b1e1754d1f4335b417b63fc3
"
DOCKER_GPG_FINGERPRINT=060A61C51B558A7F742B77AAC52FEB6B621E9F35   # Docker Release (CE rpm) key
