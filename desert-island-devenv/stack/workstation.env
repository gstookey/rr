# workstation.env -- front-end / workstation pins for the air-gapped RHEL 9 dev bundle.
# Created 2026-10-01 (vetted against the live registries that day).
# Sourced by tools/build-frontend-bundle.sh. Versions of Cypress, Playwright and the Prisma
# engine are NOT pinned here: they are derived from frontend/package-lock.json so the
# binaries can never drift from the npm packages that expect them.

NODE_VERSION=24.21.0          # Node 24 LTS "Krypton", 2026-09-07, bundles npm 11.19.0. Angular 22 needs ^24.15.0.
VSCODE_VERSION=1.140.0        # current stable 2026-10-01; Microsoft's RPM (el8 build, installs on RHEL 9)
UV_VERSION=0.12.21            # current release 2026-10-01 (the guidance doc's "0.6.x" is stale)

# Playwright browsers to stage. chromium = Chrome-for-Testing linux64 (distro-neutral) plus
# chromium-headless-shell and ffmpeg. firefox is OFF by default: on RHEL 9 Playwright still
# selects its Ubuntu 24.04 Firefox build (verified 2026-10-01 in a UBI 9 container), which
# targets a newer glibc than RHEL 9 ships. webkit is not supported on RHEL at all.
PLAYWRIGHT_BROWSERS="chromium"

# Prisma schema-engine build(s) to stage. RHEL 9 = OpenSSL 3.0 -> rhel-openssl-3.0.x.
PRISMA_BINARY_TARGETS="rhel-openssl-3.0.x"
