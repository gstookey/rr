    "@angular/material": "^22.1.5",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.26.9",
    "@stomp/rx-stomp": "^2.2.0",
    "@stomp/stompjs": "^7.2.0",
    "@my-team/legacy-app-02-common": "*",
