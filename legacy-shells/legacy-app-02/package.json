    "express-session": "1.18.0",
    "keycloak-connect": "23.0.6",
    "lodash": "^4.17.21",
    "luxon": "^3.2.1",
    "rxjs": "7.8.1",
    "tslib": "2.6.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/cdk": "^22.1.5",
    "@angular/cli": "^22.1.7",
