    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "16.2.0",
    "jsdom": "^26.1.0",
    "node-forge": "^1.3.1",
    "prettier": "^3.2.5",
    "puppeteer": "21.9.0",
