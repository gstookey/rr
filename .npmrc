# ACME Workshop / RR workspace — npm workspaces (ADR-004).
# engine-strict makes the Node floor in package.json#engines a hard failure
# rather than a warning: Angular 22 does not run below Node 22.22.3, and a
# silent "works on my machine" is exactly the failure the island cannot debug.
engine-strict=true
# Deterministic installs; the lockfile is the contract that crosses the fence.
save-exact=true
# The island has no Puppeteer and no Chromium download budget (CURRENT_STATE).
puppeteer_skip_download=true
